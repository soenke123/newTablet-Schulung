es schickt, was nicht in sein eigenes Netz gehört.</p>","netz":{"v":1,"nodes":[{"id":"r1","kind":"host","name":"Endgerät 1","x":175,"y":340,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:c9:7f:57","ip":"192.168.1.10","mask":"255.255.255.0","dhcp":false,"up":true}],"dateien":{"/Bilder":{"ordner":true},"/Bilder/schule.svg":{"bild":"@schule"},"/Bilder/landschaft.svg":{"bild":"@foto"},"/Bilder/marke.svg":{"bild":"@logo"},"/Bilder/smiley.svg":{"bild":"@smiley"}}},{"id":"r2","kind":"host","name":"Endgerät 2","x":175,"y":590,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:ca:86:76","ip":"192.168.1.11","mask":"255.255.255.0","dhcp":false,"up":true}],"dateien":{"/Bilder":{"ordner":true},"/Bilder/schule.svg":{"bild":"@schule"},"/Bilder/landschaft.svg":{"bild":"@foto"},"/Bilder/marke.svg":{"bild":"@logo"},"/Bilder/smiley.svg":{"bild":"@smiley"}}},{"id":"r3","kind":"switch","name":"Switch 1","x":395,"y":465,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:cb:8d:95","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":1,"mac":"02:00:5e:cc:94:b4","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":2,"mac":"02:00:5e:cd:9b:d3","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":3,"mac":"02:00:5e:ce:a2:f2","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":4,"mac":"02:00:5e:cf:a9:11","ip":"","mask":"255.255.255.0","dhcp":false,"up":true}]},{"id":"r4","kind":"router","name":"Router 1","x":600,"y":465,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:d0:b0:30","ip":"192.168.1.1","mask":"255.255.255.0","dhcp":false,"up":true},{"i":1,"mac":"02:00:5e:d1:b7:4f","ip":"192.168.2.1","mask":"255.255.255.0","dhcp":false,"up":true}]},{"id":"r5","kind":"switch","name":"Switch 2","x":805,"y":465,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:d2:be:6e","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":1,"mac":"02:00:5e:d3:c5