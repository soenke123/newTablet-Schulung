s andere erreichen — prüfe es mit <code>ping</code>.</p><p class=\"dim\">Ein Fehler trägt ein Warnzeichen. Die beiden anderen nicht: dort ist alles gültig eingetragen und trotzdem falsch. Die findest du nur im Mitschnitt — sieh genau hin, wer auf eine Frage antwortet und wie oft.</p>","netz":{"v":1,"nodes":[{"id":"f1","kind":"host","name":"Endgerät 1","x":175,"y":340,"gateway":"192.168.1.1","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:2d:3b:73","ip":"192.168.1.10","mask":"255.255.255.0","dhcp":false,"up":true}],"dateien":{"/Bilder":{"ordner":true},"/Bilder/schule.svg":{"bild":"@schule"},"/Bilder/landschaft.svg":{"bild":"@foto"},"/Bilder/marke.svg":{"bild":"@logo"},"/Bilder/smiley.svg":{"bild":"@smiley"}}},{"id":"f2","kind":"host","name":"Endgerät 2","x":175,"y":590,"gateway":"192.168.1.1","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:2e:42:92","ip":"192.168.1.10","mask":"255.255.255.0","dhcp":false,"up":true}],"dateien":{"/Bilder":{"ordner":true},"/Bilder/schule.svg":{"bild":"@schule"},"/Bilder/landschaft.svg":{"bild":"@foto"},"/Bilder/marke.svg":{"bild":"@logo"},"/Bilder/smiley.svg":{"bild":"@smiley"}}},{"id":"f3","kind":"switch","name":"Switch 1","x":395,"y":465,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:2f:49:b1","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":1,"mac":"02:00:5e:30:50:d0","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":2,"mac":"02:00:5e:31:57:ef","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":3,"mac":"02:00:5e:32:5e:0e","ip":"","mask":"255.255.255.0","dhcp":false,"up":true},{"i":4,"mac":"02:00:5e:33:65:2d","ip":"","mask":"255.255.255.0","dhcp":false,"up":true}]},{"id":"f4","kind":"router","name":"Router 1","x":600,"y":465,"gateway":"","dns":"","on":true,"routes":[],"nics":[{"i":0,"mac":"02:00:5e:34:6c:4c","ip":"192.168.1.1","mask":"255.255.255.0","dhcp":false,"up":true},{"i":1,"mac":"02:00:5e:35:73:6b","ip":"192.168.2.1","mask":"255.255.255.240","