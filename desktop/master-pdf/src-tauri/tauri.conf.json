{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Master PDF Skill",
  "version": "1.0.0",
  "identifier": "de.mps-ki.masterpdfskill",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Master PDF Skill",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MPSkills",
    "shortDescription": "PDFs lesen und bearbeiten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Master PDF Skill PDF",
        "description": "PDF-Dokument",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
